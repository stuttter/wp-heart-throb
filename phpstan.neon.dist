parameters:
    level: 7
    phpVersion: 70400
    paths:
        - wp-heart-throb.php
        - wp-heart-throb
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    stubFiles:
        - phpstan-wordpress-versions.stub
    tmpDir: build/phpstan
    parallel:
        maximumNumberOfProcesses: 1
